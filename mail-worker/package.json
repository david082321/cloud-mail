{
	"name": "mail-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.16.0",
	"scripts": {
		"dev": "wrangler dev --config wrangler-dev.toml",
		"test": "wrangler deploy --config wrangler-test.toml",
		"test:extension": "vitest run --config vitest-extension.config.js && vitest run --config vitest-extension.integration.config.js",
		"deploy": "wrangler deploy",
		"start": "wrangler dev"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.0",
		"vitest": "^4.1.10",
		"wrangler": "^4.120.1"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1106.0",
		"dayjs": "^1.11.13",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.1",
		"i18next": "^25.3.2",
		"linkedom": "^0.18.10",
		"postal-mime": "^2.4.3",
		"resend": "^6.18.1",
		"ua-parser-js": "^2.0.10",
		"web-push": "^3.6.7"
	}
}
